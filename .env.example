# Google Cloud console -> APIs & Services -> Credentials -> OAuth client (Web).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Signs and encrypts the session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=your_generated_random_auth_secret

# Required when self-hosting (npm start behind any host other than Vercel).
AUTH_TRUST_HOST=true

# Must match the origin the app is actually opened on.
NEXTAUTH_URL=http://localhost:3000
